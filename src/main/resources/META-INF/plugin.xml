<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>com.up3d.i18n.helper</id>
    <name>i18n Helper</name>
    <vendor>UP3D</vendor>

    <description><![CDATA[
    前端国际化（i18n）辅助插件，对齐 i18n-ally-next 的核心体验。<br/>
    支持框架：i18next、vue-i18n、react-i18next、i18n-js。<br/>
    覆盖 js / jsx / ts / tsx / vue / html。
    <ul>
      <li>行内译文提示：<code>t('key')</code> 后直接显示译文</li>
      <li>侧边栏多语言对照表：按语言分列，区分已翻译 / 空 / 缺失 / 过期</li>
      <li>语言包一致性扫描与诊断</li>
      <li>批量机器翻译（Google 免费端点，无需密钥）</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="i18n.helper.notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <!-- 行内译文提示：在 t('key') 之后显示对应语言的译文。
             覆盖 js / jsx / ts / tsx / vue / html，语言清单见 I18nInlayProviderFactory。 -->
        <codeInsight.declarativeInlayProviderFactory
                implementation="com.up3d.i18n.editor.I18nInlayProviderFactory"/>

        <!-- 设置页：语言包路径、路径模式、源语言、匹配正则全部可配。 -->
        <projectConfigurable parentId="tools"
                             instance="com.up3d.i18n.settings.I18nConfigurable"
                             id="com.up3d.i18n.settings"
                             displayName="i18n Helper"/>

        <!-- 侧边栏 i18n 面板：多语言对照表 + 翻译进度。 -->
        <toolWindow id="i18n-helper"
                    anchor="right"
                    factoryClass="com.up3d.i18n.ui.I18nToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="com.up3d.i18n.ShowPanel"
                class="com.up3d.i18n.actions.ShowPanelAction"
                text="i18n: 打开翻译面板"
                description="在侧边栏打开多语言翻译对照表">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="com.up3d.i18n.RefreshPanel"
                class="com.up3d.i18n.actions.RefreshPanelAction"
                text="i18n: 刷新翻译面板"
                description="重新扫描语言包并刷新侧边栏表格">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="com.up3d.i18n.ScanLocales"
                class="com.up3d.i18n.actions.ScanLocalesAction"
                text="i18n: 扫描语言包一致性"
                description="扫描项目内的 i18n 语言包，统计各语言 key 的缺失与多余情况">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="com.up3d.i18n.DiagnoseCurrentFile"
                class="com.up3d.i18n.actions.DiagnoseCurrentFileAction"
                text="i18n: 诊断当前文件的译文提示"
                description="逐步检查当前文件为何显示/不显示行内译文提示，并预览将要显示的译文">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="com.up3d.i18n.BatchTranslate"
                class="com.up3d.i18n.actions.BatchTranslateAction"
                text="i18n: 批量翻译缺失文案"
                description="以源语言为准，把各语言缺失的 key 机器翻译补齐，写入前先预览确认">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>